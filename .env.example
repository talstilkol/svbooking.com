# SV Booking production readiness template.
# Do not commit real secret values. Copy to .env.local / deployment env and fill values there.

# Required for admin mutation/read endpoints and production cron.
ADMIN_API_SECRET=
CRON_SECRET=

# Required for durable candidate queue, agent status, price cache, price alerts, and audit logs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required for production account/auth flows.
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=
KINDE_POST_LOGOUT_REDIRECT_URL=
KINDE_POST_LOGIN_REDIRECT_URL=

# Optional pricing/discovery providers. Xotelo dated rates remain available without auth.
RAPIDAPI_KEY=
SERPAPI_KEY=
MAKCORPS_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Optional enrichment providers.
TICKETMASTER_API_KEY=
OPENTRIPMAP_API_KEY=

# Optional licensed review provider readiness marker.
# Set only after legal/partner review access exists.
# REVIEWS_PROVIDER_NAME=google-places enables the Google Places adapter
# (requires GOOGLE_PLACES_API_KEY). Leave blank to keep reviews "unavailable".
REVIEWS_PROVIDER_NAME=
REVIEWS_PROVIDER_LICENSED=
GOOGLE_PLACES_API_KEY=

# Required to use the browser admin dashboard bridge.
# Comma-separated Kinde user ids and/or emails; leave empty to fail closed.
ADMIN_USER_IDS=
ADMIN_EMAILS=

# Optional notification webhook for triggered price alerts.
# Payloads contain deterministic user fingerprints, not raw user ids.
PRICE_ALERT_WEBHOOK_URL=
PRICE_ALERT_WEBHOOK_SECRET=
PRICE_ALERT_UNSUBSCRIBE_SECRET=

# Optional notification webhook for operational SLO alerts.
# Payloads contain severity counts and sanitized evidence only, not secret values.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_SECRET=

# Optional web push readiness for mobile/PWA retention.
NEXT_PUBLIC_PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
