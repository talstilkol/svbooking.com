{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:debt:report": "node scripts/typecheck-debt-report.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:coverage": "npm run test:coverage -- --coverage.reporter=json-summary && node scripts/audit-coverage.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "release:state": "node scripts/release-state.mjs",
    "release:state:strict": "node scripts/release-state.mjs --strict",
    "launch:readiness:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/launch-readiness-report.mjs",
    "audit:launch-readiness-report": "node scripts/audit-launch-readiness-report.mjs",
    "audit:guardrails": "node scripts/audit-guardrails.mjs",
    "audit:provenance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-provenance.mjs",
    "audit:deployment-smoke": "node scripts/audit-deployment-smoke.mjs",
    "smoke:deployment": "node scripts/deployment-smoke.mjs",
    "audit:catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-catalog.mjs",
    "audit:catalog-media-ledger": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-catalog-media-ledger.mjs",
    "catalog:media:ledger": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/catalog-media-action-ledger.mjs",
    "catalog:media:ledger:summary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/catalog-media-action-ledger.mjs --format=summary --priority-only",
    "catalog:media:ledger:csv": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/catalog-media-action-ledger.mjs --format=csv",
    "audit:docs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-docs.mjs",
    "audit:master-plan": "node scripts/audit-master-plan.mjs",
    "audit:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-env-contract.mjs",
    "audit:secrets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-secret-hygiene.mjs",
    "audit:runtime": "node scripts/audit-runtime-warnings.mjs",
    "audit:external-fetches": "node scripts/audit-external-fetches.mjs",
    "audit:public-api-urls": "node scripts/audit-public-api-url-safety.mjs",
    "audit:public-data-contracts": "node scripts/audit-public-data-contracts.mjs",
    "audit:affiliate-security": "node scripts/audit-affiliate-security.mjs",
    "audit:legal-readiness": "node scripts/audit-legal-readiness.mjs",
    "audit:security-responses": "node scripts/audit-security-responses.mjs",
    "audit:api-errors": "node scripts/audit-api-error-cache.mjs",
    "audit:cron-cache": "node scripts/audit-cron-cache.mjs",
    "audit:ops": "node scripts/audit-ops-readiness.mjs",
    "audit:agents": "node scripts/audit-agents.mjs",
    "audit:duplicates": "node scripts/audit-duplicates.mjs",
    "audit:providers": "node scripts/audit-providers.mjs",
    "audit:reviews": "node scripts/audit-reviews.mjs",
    "audit:release-deletions": "node scripts/audit-release-deletions.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "audit:price-accuracy": "node scripts/audit-price-accuracy.mjs",
    "audit:pwa": "node scripts/audit-pwa.mjs",
    "audit:rum": "node scripts/audit-rum.mjs",
    "audit:ops-scorecard": "node scripts/audit-ops-scorecard.mjs",
    "audit:ui-quality": "node scripts/audit-ui-quality.mjs",
    "audit:accessibility": "node scripts/audit-accessibility.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:html-safety": "node scripts/audit-html-safety.mjs",
    "audit:csrf": "node scripts/audit-csrf.mjs",
    "audit:storage": "node scripts/audit-storage-keys.mjs",
    "audit:data-retention": "node scripts/audit-data-retention.mjs",
    "audit:privacy": "node scripts/audit-privacy.mjs",
    "audit:alerts": "node scripts/audit-alerts.mjs",
    "audit:production": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-production-readiness.mjs",
    "audit:production:strict": "PRODUCTION_READINESS_STRICT=1 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-production-readiness.mjs",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:ui": "env -u NO_COLOR playwright test --ui",
    "test:e2e:install": "playwright install chromium"
